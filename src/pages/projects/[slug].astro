---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const webpImage = project.data.image.replace(/\.(png|jpg|jpeg)$/i, ".webp");
---

<BaseLayout
  title={`${project.data.title} — Étude d'Ingénierie STAR | Charles Cyrille Kamga Mukam`}
  description={project.data.description}
  image={project.data.image}
  currentPath="/projects"
>
  <article class="case-study-container">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb font-mono" aria-label="Fil d'Ariane">
      <a href="/">
        <i class="fas fa-home" aria-hidden="true"></i> overview
      </a>
      <span class="sep">/</span>
      <a href="/projects">projets</a>
      <span class="sep">/</span>
      <span class="current">{project.id}</span>
    </nav>

    <!-- Header Section -->
    <header class="study-header bento-card">
      <div class="header-meta">
        <span class="category-tag font-mono">{project.data.categoryLabel}</span>
        <span class="protocol-badge font-mono">
          <i class="fas fa-terminal" aria-hidden="true"></i>{" "}
          {project.data.badge}
        </span>
      </div>

      <h1 class="study-title">{project.data.title}</h1>
      <p class="study-lead">{project.data.description}</p>

      {project.data.metrics && project.data.metrics.length > 0 && (
        <div class="study-metrics-row">
          {project.data.metrics.map((m) => (
            <div class="study-metric font-mono">
              <span class="m-key">{m.label}</span>
              <span class="m-val">{m.value}</span>
            </div>
          ))}
        </div>
      )}

      <div class="study-tags tech-stack">
        {project.data.tags.map((t) => (
          <span class="tech-tag accent">{t}</span>
        ))}
      </div>

      <div class="study-actions">
        {project.data.sourceUrl && (
          <a
            href={project.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <i class="fab fa-github" aria-hidden="true"></i>
            <span>Code source GitHub</span>
          </a>
        )}
        {project.data.demoUrl && (
          <a
            href={project.data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
            <span>Release / Téléchargement</span>
          </a>
        )}
        <a href="/contact" class="btn btn-secondary">
          <i class="fas fa-paper-plane" aria-hidden="true"></i>
          <span>Discuter de l'architecture</span>
        </a>
      </div>
    </header>

    <!-- Media Showcase -->
    <div class="study-media bento-card">
      <picture>
        <source srcset={webpImage} type="image/webp" />
        <img
          src={project.data.image}
          alt={`Aperçu technique de ${project.data.title}`}
          class="study-image"
          loading="eager"
        />
      </picture>
    </div>

    <!-- STAR Markdown Content -->
    <div class="study-body bento-card">
      <div class="star-indicator font-mono">
        <i class="fas fa-file-code" aria-hidden="true"></i>
        <span>
          MODÈLE STAR : SITUATION · TÂCHE · ACTION · RÉSULTATS &amp; RETOURS
          D'EXPÉRIENCE
        </span>
      </div>

      <div class="markdown-prose">
        <Content />
      </div>

      <div class="study-nav-footer">
        <a href="/projects" class="btn btn-secondary">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          <span>Retour aux réalisations</span>
        </a>
        <a href="/contact" class="btn btn-primary">
          <i class="fas fa-envelope" aria-hidden="true"></i>
          <span>Échanger sur ce projet</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    color: var(--text-dim);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: #ffffff;
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.1);
  }

  .breadcrumb .current {
    color: var(--accent-primary);
  }

  .study-header {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .category-tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .protocol-badge {
    font-size: 0.74rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .study-title {
    font-size: 2.1rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .study-lead {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .study-metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 12px 16px;
  }

  .study-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m-key {
    font-size: 0.68rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .m-val {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f4f4f5;
  }

  .study-actions {
    display: flex;
    gap: 10px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .study-media {
    overflow: hidden;
    padding: 0;
    max-height: 420px;
    background: #09090b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .study-image {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: contain;
  }

  .study-body {
    padding: 32px;
  }

  .star-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    color: var(--accent-primary);
    background: rgba(56, 189, 248, 0.06);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .markdown-prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 28px;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .markdown-prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-top: 18px;
    margin-bottom: 8px;
  }

  .markdown-prose :global(p) {
    font-size: 0.92rem;
    color: #d4d4d8;
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .markdown-prose :global(ul),
  .markdown-prose :global(ol) {
    margin-left: 20px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .markdown-prose :global(li) {
    font-size: 0.9rem;
    color: #d4d4d8;
    line-height: 1.6;
  }

  .markdown-prose :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .markdown-prose :global(code) {
    background: rgba(255, 255, 255, 0.06);
    color: var(--accent-primary);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.85em;
    font-family: var(--font-mono);
  }

  .study-nav-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .study-title {
      font-size: 1.6rem;
    }
    .study-header,
    .study-body {
      padding: 18px;
    }
    .study-actions {
      flex-direction: column;
    }
    .study-actions .btn {
      width: 100%;
    }
    .study-nav-footer {
      flex-direction: column;
    }
    .study-nav-footer .btn {
      width: 100%;
    }
  }
</style>
