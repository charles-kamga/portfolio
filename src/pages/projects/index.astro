---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const order = [
  "darwinxshare",
  "faceless-pipeline",
  "darwinx-neighbour",
  "meetlocal",
];
const sortedProjects = [...allProjects].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});
---

<BaseLayout
  title="Réalisations & Systèmes — Charles Cyrille Kamga Mukam"
  description="Catalogue des réalisations techniques : Moteur Wi-Fi direct, Pipeline multimédia FastAPI/ONNX, HUD Linux Hyprland et WebRTC."
  currentPath="/projects"
>
  <div class="projects-page">
    <header class="page-header">
      <div class="section-label">
        <i class="fas fa-terminal" aria-hidden="true"></i>
        <span>Codebase &amp; Architecture Réelle</span>
      </div>
      <h1 class="page-title">Réalisations &amp; Projets Systèmes</h1>
      <p class="page-desc">
        Études de cas d'ingénierie rédigées au format STAR. Analyse de
        problématiques concrètes, architecture technique, résolution d'incidents
        et enseignements clés.
      </p>
    </header>

    <!-- Clean Filter Bar -->
    <div
      class="filter-bar font-mono"
      role="toolbar"
      aria-label="Filtrer les projets"
    >
      <button class="filter-btn active" data-filter="all">
        <span>ALL_PROJECTS</span>
      </button>
      <button class="filter-btn" data-filter="sys">
        <span>SYSTEMS &amp; NETWORKS</span>
      </button>
      <button class="filter-btn" data-filter="ai">
        <span>BACKEND &amp; ONNX</span>
      </button>
      <button class="filter-btn" data-filter="desktop">
        <span>LINUX HUD</span>
      </button>
      <button class="filter-btn" data-filter="web">
        <span>WEBRTC STREAM</span>
      </button>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projects-grid">
      {sortedProjects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          category={project.data.category}
          categoryLabel={project.data.categoryLabel}
          tags={project.data.tags}
          image={project.data.image}
          badge={project.data.badge}
          sourceUrl={project.data.sourceUrl}
          demoUrl={project.data.demoUrl}
          metrics={project.data.metrics}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const projectCards = document.querySelectorAll<HTMLElement>(".project-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.dataset.filter;

      projectCards.forEach((card) => {
        if (filter === "all" || card.dataset.category === filter) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .projects-page {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  /* Filter Bar */
  .filter-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
  }

  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border-color: var(--border-hover);
  }

  .filter-btn.active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent-primary);
    border-color: var(--border-accent);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.6rem;
    }
  }
</style>
