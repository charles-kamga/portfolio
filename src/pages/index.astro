---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroWidget from "../components/HeroWidget.astro";
import SystemSpecsWidget from "../components/SystemSpecsWidget.astro";
import EngineeringPhilosophy from "../components/EngineeringPhilosophy.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import certifications from "../content/certifications/certifications.json";

const allProjects = await getCollection("projects");
const order = [
  "darwinxshare",
  "faceless-pipeline",
  "darwinx-neighbour",
  "meetlocal",
];
const sortedProjects = [...allProjects].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const featuredCert =
  certifications.find((c) => c.id === "1") || certifications[0];
---

<BaseLayout
  title="Charles Cyrille Kamga Mukam — Développeur Backend & Systèmes"
  description="Ingénierie logicielle & systèmes sous Linux. Services asynchrones Python (FastAPI/Flask), protocoles réseau, WebRTC et sécurité applicative."
  currentPath="/"
>
  <div class="dashboard-container">
    <!-- Top Bento Section: Hero + Workstation Telemetry -->
    <section
      class="bento-row hero-row"
      aria-label="Présentation et environnement système"
    >
      <div class="bento-col-hero">
        <HeroWidget />
      </div>
      <div class="bento-col-telemetry">
        <SystemSpecsWidget />
      </div>
    </section>

    <!-- Second Bento Section: Engineering Pillars + Verified IBM Credential Spotlight -->
    <section
      class="bento-row mid-row"
      aria-label="Architecture et accréditations majeures"
    >
      <div class="bento-col-pillars">
        <EngineeringPhilosophy />
      </div>

      <div class="bento-col-spotlight">
        <div class="cert-spotlight bento-card">
          <div class="spotlight-header">
            <div class="section-label">
              <i class="fas fa-certificate" aria-hidden="true"></i>
              <span>Accréditation Professionnelle</span>
            </div>
            <span class="cert-verified-tag font-mono">
              <i class="fas fa-check-circle" aria-hidden="true"></i> Verified
              IBM
            </span>
          </div>

          <div class="spotlight-body">
            <div class="spotlight-badge-container">
              <picture>
                <source
                  srcset="/assets/certifications/images/IBM Cybersecurity Analyst.webp"
                  type="image/webp"
                />
                <img
                  src="/assets/certifications/images/IBM Cybersecurity Analyst.png"
                  alt="IBM Cybersecurity Analyst"
                  class="spotlight-cert-badge"
                  loading="lazy"
                />
              </picture>
            </div>
            <div class="spotlight-text">
              <h3 class="spotlight-cert-title">{featuredCert.title}</h3>
              <p class="spotlight-cert-desc">
                Cursus de spécialisation IBM (8 modules) : analyse de menaces
                réseau, tests d'intrusion méthodiques, conformité CIA et défense
                en profondeur.
              </p>
            </div>
          </div>

          <div class="spotlight-meta font-mono">
            <div class="meta-tag">
              <span class="meta-key">PRACTICE</span>
              <span class="meta-value">Arch Linux / Sockets / HTB Labs</span>
            </div>
          </div>

          <div class="spotlight-actions">
            <a
              href={featuredCert.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <i
                class="fas fa-arrow-up-right-from-square"
                aria-hidden="true"
              ></i>
              <span>Consulter l'attestation</span>
            </a>
            <a href="/certifications" class="btn btn-secondary">
              <span>Voir les 8 cursus</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Third Section: Synchronized Real Projects Showcase -->
    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-header">
        <div>
          <div class="section-label">
            <i class="fas fa-code-branch" aria-hidden="true"></i>
            <span>Production &amp; Ingénierie Réelle</span>
          </div>
          <h2 id="projects-title" class="section-title">
            Réalisations &amp; Projets Systèmes
          </h2>
          <p class="section-desc">
            Applications développées, testées et exécutées sur poste de travail
            Linux avec analyse d'architecture et étude de cas STAR.
          </p>
        </div>
        <a href="/projects" class="btn btn-secondary">
          <span>Tous les projets</span>
          <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard
            slug={project.id}
            title={project.data.title}
            description={project.data.description}
            category={project.data.category}
            categoryLabel={project.data.categoryLabel}
            tags={project.data.tags}
            image={project.data.image}
            badge={project.data.badge}
            sourceUrl={project.data.sourceUrl}
            demoUrl={project.data.demoUrl}
            metrics={project.data.metrics}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .dashboard-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .bento-row {
    display: grid;
    gap: 20px;
  }

  /* Row 1: Hero (approx 65%) + Telemetry (approx 35%) */
  .hero-row {
    grid-template-columns: 1.8fr 1fr;
  }

  /* Row 2: Pillars (approx 55%) + Spotlight (approx 45%) */
  .mid-row {
    grid-template-columns: 1.25fr 1fr;
  }

  /* Spotlight Card Specifics */
  .cert-spotlight {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 16px;
  }

  .spotlight-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cert-verified-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--accent-primary);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .spotlight-body {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .spotlight-badge-container {
    width: 68px;
    height: 68px;
    border-radius: 8px;
    background: #0d0d12;
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    flex-shrink: 0;
  }

  .spotlight-cert-badge {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .spotlight-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spotlight-cert-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  .spotlight-cert-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .spotlight-meta {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .meta-key {
    color: var(--text-dim);
    margin-right: 8px;
  }

  .meta-value {
    color: var(--accent-primary);
    font-weight: 500;
  }

  .spotlight-actions {
    display: flex;
    gap: 10px;
    margin-top: auto;
  }

  .spotlight-actions .btn {
    font-size: 0.82rem;
  }

  /* Projects Section */
  .projects-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 1200px) {
    .hero-row {
      grid-template-columns: 1fr;
    }
    .mid-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .spotlight-body {
      flex-direction: column;
      align-items: flex-start;
    }
    .spotlight-actions {
      flex-direction: column;
    }
    .spotlight-actions .btn {
      width: 100%;
    }
  }
</style>
