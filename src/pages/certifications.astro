---
import BaseLayout from "../layouts/BaseLayout.astro";
import CertCard from "../components/CertCard.astro";
import certifications from "../content/certifications/certifications.json";

const categories = [
  {
    key: "cybersecurity",
    label: "CYBERSECURITY",
    icon: "fas fa-shield-halved",
  },
  {
    key: "networks",
    label: "NETWORKS & TELECOMS",
    icon: "fas fa-network-wired",
  },
  { key: "systems", label: "SYSTEMS & DATA", icon: "fas fa-server" },
];

const cyberCerts = certifications.filter((c) => c.category === "Cybersecurity");
const networkCerts = certifications.filter((c) => c.category === "Networks");
const systemCerts = certifications.filter((c) => c.category === "Systems");
---

<BaseLayout
  title="Accréditations & Certifications — Charles Cyrille Kamga Mukam"
  description="Cursus professionnels certifiés (IBM, Yonsei) : Cybersécurité, Réseaux et Systèmes sous Linux avec contexte d'application réel."
  currentPath="/certifications"
>
  <div class="certifications-page">
    <header class="page-header">
      <div class="section-label">
        <i class="fas fa-certificate" aria-hidden="true"></i>
        <span>Accréditations Officielles &amp; Validations</span>
      </div>
      <h1 class="page-title">Certifications Techniques</h1>
      <p class="page-desc">
        Parcours spécialisés délivrés par des institutions de référence (IBM,
        Yonsei). Chaque accréditation est vérifiable publiquement et
        s'accompagne de son contexte d'application concrète sur machine réelle.
      </p>
    </header>

    <!-- Quick Navigation -->
    <nav class="cat-nav font-mono" aria-label="Accès direct aux domaines">
      {categories.map((c) => (
        <a href={`#${c.key}`} class="cat-link">
          <i class={c.icon} aria-hidden="true"></i>
          <span>{c.label}</span>
        </a>
      ))}
    </nav>

    <!-- Thematic Groups -->
    <section class="group-section" id="cybersecurity">
      <div class="group-header">
        <div class="group-title font-mono">
          <i class="fas fa-shield-halved" aria-hidden="true"></i>
          <span>CYBERSECURITY &amp; DEFENSE ({cyberCerts.length})</span>
        </div>
      </div>

      <div class="certs-grid">
        {cyberCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>

    <section class="group-section" id="networks">
      <div class="group-header">
        <div class="group-title font-mono">
          <i class="fas fa-network-wired" aria-hidden="true"></i>
          <span>NETWORKS &amp; TELECOMS ({networkCerts.length})</span>
        </div>
      </div>

      <div class="certs-grid">
        {networkCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>

    <section class="group-section" id="systems">
      <div class="group-header">
        <div class="group-title font-mono">
          <i class="fas fa-server" aria-hidden="true"></i>
          <span>SYSTEMS &amp; DATA INTEGRITY ({systemCerts.length})</span>
        </div>
      </div>

      <div class="certs-grid">
        {systemCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .certifications-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  .cat-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cat-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.74rem;
    transition: var(--transition);
  }

  .cat-link:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border-color: var(--border-hover);
  }

  .group-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .group-header {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .group-title {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .group-title i {
    color: var(--accent-primary);
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  @media (max-width: 900px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.6rem;
    }
  }
</style>
