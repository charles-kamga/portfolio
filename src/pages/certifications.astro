---
import BaseLayout from "../layouts/BaseLayout.astro";
import CertCard from "../components/CertCard.astro";
import certifications from "../content/certifications/certifications.json";

const categories = [
  { key: "all", label: "Toutes les accréditations", icon: "fas fa-border-all" },
  { key: "Cybersecurity", label: "Cybersécurité", icon: "fas fa-shield-alt" },
  { key: "Networks", label: "Réseaux", icon: "fas fa-network-wired" },
  { key: "Systems", label: "Systèmes & Données", icon: "fas fa-server" },
];

const cyberCerts = certifications.filter((c) => c.category === "Cybersecurity");
const networkCerts = certifications.filter((c) => c.category === "Networks");
const systemCerts = certifications.filter((c) => c.category === "Systems");
---

<BaseLayout
  title="Accréditations & Certifications | Charles Kamga Mukam"
  description="Accréditations et certifications officielles de Charles Kamga Mukam : IBM Cybersecurity Analyst, Réseaux et Systèmes."
  currentPath="/certifications"
>
  <div class="certifications-page">
    <header class="page-header">
      <div class="header-badge">
        <i class="fas fa-certificate" aria-hidden="true"></i>
        <span>Validation Technique Reconnue</span>
      </div>
      <h1 class="page-title">Accréditations &amp; Certifications</h1>
      <p class="page-desc">
        Parcours de formation certifié auprès d'institutions mondiales (IBM,
        Yonsei). Chaque certification est vérifiable en ligne et enrichie d'une
        note honnête sur sa mise en pratique réelle.
      </p>
    </header>

    <!-- Quick navigation bar -->
    <nav class="category-nav" aria-label="Accès rapide aux domaines">
      {categories.slice(1).map((cat) => (
        <a href={`#${cat.key.toLowerCase()}`} class="cat-pill">
          <i class={cat.icon} aria-hidden="true"></i>
          <span>{cat.label}</span>
        </a>
      ))}
    </nav>

    <!-- Thematic Groups Overview -->
    <section class="thematic-group" id="cybersecurity">
      <div class="group-title-wrapper">
        <div class="group-badge cyber">
          <i class="fas fa-shield-alt" aria-hidden="true"></i>
          <span>Cybersécurité &amp; Défense</span>
        </div>
        <span class="group-count">{cyberCerts.length} certifications</span>
      </div>

      <div class="certs-grid">
        {cyberCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>

    <section class="thematic-group" id="networks">
      <div class="group-title-wrapper">
        <div class="group-badge networks">
          <i class="fas fa-network-wired" aria-hidden="true"></i>
          <span>Réseaux &amp; Télécoms</span>
        </div>
        <span class="group-count">{networkCerts.length} certifications</span>
      </div>

      <div class="certs-grid">
        {networkCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>

    <section class="thematic-group" id="systems">
      <div class="group-title-wrapper">
        <div class="group-badge systems">
          <i class="fas fa-server" aria-hidden="true"></i>
          <span>Systèmes d'Exploitation &amp; Données</span>
        </div>
        <span class="group-count">{systemCerts.length} certifications</span>
      </div>

      <div class="certs-grid">
        {systemCerts.map((cert) => (
          <CertCard
            title={cert.title}
            issuer={cert.issuer}
            date={cert.date}
            category={cert.category}
            skills={cert.skills}
            image={cert.image}
            url={cert.url}
            practicalNote={cert.practicalNote}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .certifications-page {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 750px;
    line-height: 1.6;
  }

  .category-nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.86rem;
    font-weight: 500;
    transition: var(--transition);
  }

  .cat-pill:hover {
    background: rgba(0, 209, 255, 0.1);
    color: var(--accent-primary);
    border-color: rgba(0, 209, 255, 0.3);
    transform: translateY(-2px);
  }

  .thematic-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .group-title-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .group-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .group-badge.cyber i {
    color: var(--accent-primary);
  }

  .group-badge.networks i {
    color: #818cf8;
  }

  .group-badge.systems i {
    color: #34d399;
  }

  .group-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 10px;
    border-radius: 20px;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  @media (max-width: 1024px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.7rem;
    }
  }
</style>
