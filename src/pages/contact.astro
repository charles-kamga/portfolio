---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact & Réseau — Charles Cyrille Kamga Mukam"
  description="Contactez Charles Cyrille Kamga Mukam, Développeur Backend & Systèmes. Échanges techniques, architecture logicielle et opportunités professionnelles."
  currentPath="/contact"
>
  <div class="contact-page">
    <header class="page-header">
      <div class="section-label">
        <i class="fas fa-paper-plane" aria-hidden="true"></i>
        <span>Canaux de Communication Directs</span>
      </div>
      <h1 class="page-title">Contact &amp; Échanges Professionnels</h1>
      <p class="page-desc">
        Disponible pour échanger autour d'opportunités en ingénierie logicielle
        backend, architectures distribuées, protocoles système sous Linux ou
        contributions open-source.
      </p>
    </header>

    <div class="contact-layout">
      <!-- Main Direct Reach Card -->
      <div class="contact-primary bento-card">
        <div class="primary-header">
          <span class="status-indicator-tag font-mono">
            <span class="status-pulse"></span>
            <span>AVAILABLE · BACKEND &amp; SYSTEMS</span>
          </span>
          <span class="location-badge font-mono">
            Yaoundé, Cameroun · Remote OK
          </span>
        </div>

        <div class="primary-body">
          <h2 class="contact-h2">Échangeons par e-mail direct</h2>
          <p class="contact-p">
            Pour toute proposition de poste (CDI, missions d'ingénierie, projets
            backend), le courrier électronique reste le canal privilégié avec
            réponse sous 24 à 48 heures.
          </p>

          <a href="mailto:charleskamgapr@gmail.com" class="direct-email-card">
            <div class="email-icon">
              <i class="fas fa-envelope" aria-hidden="true"></i>
            </div>
            <div class="email-details font-mono">
              <span class="email-hint">PRIMARY_CONTACT</span>
              <span class="email-val">charleskamgapr@gmail.com</span>
            </div>
            <i
              class="fas fa-arrow-up-right-from-square email-action-icon"
              aria-hidden="true"
            ></i>
          </a>
        </div>
      </div>

      <!-- Professional Networks Column -->
      <div class="networks-column">
        <div class="network-card bento-card">
          <div class="network-header">
            <i class="fab fa-github" aria-hidden="true"></i>
            <div>
              <h3>GitHub</h3>
              <p>Dépôts publics, implémentations et commits réguliers</p>
            </div>
          </div>
          <a
            href="https://github.com/charles-kamga"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary font-mono"
          >
            <span>github.com/charles-kamga</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="network-card bento-card">
          <div class="network-header">
            <i class="fab fa-linkedin" aria-hidden="true"></i>
            <div>
              <h3>LinkedIn</h3>
              <p>Parcours académique en ICT et validations officielles</p>
            </div>
          </div>
          <a
            href="https://www.linkedin.com/in/charles-kamga-mukam/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary font-mono"
          >
            <span>charles-kamga-mukam</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="network-card bento-card">
          <div class="network-header">
            <i class="fab fa-youtube" aria-hidden="true"></i>
            <div>
              <h3>Charltech (YouTube)</h3>
              <p>
                Chaîne de vulgarisation technique, systèmes et développement
              </p>
            </div>
          </div>
          <div class="network-tag font-mono">
            <span>COMMUNITY_EDUCATION</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Community Ecosystem -->
    <section
      class="ecosystem-section bento-card"
      aria-labelledby="ecosystem-title"
    >
      <div class="section-label">
        <i class="fas fa-users" aria-hidden="true"></i>
        <span id="ecosystem-title">Écosystème &amp; Engagement Technique</span>
      </div>

      <div class="ecosystem-grid">
        <div class="eco-item">
          <div class="eco-icon python">
            <i class="fab fa-python" aria-hidden="true"></i>
          </div>
          <div class="eco-text">
            <h4>Python Cameroun</h4>
            <p>
              Membre actif et contributeur de la communauté locale des
              ingénieurs Python. Veille technique sur l'asynchronisme, les
              frameworks backend et l'écosystème open-source.
            </p>
          </div>
        </div>

        <div class="eco-item">
          <div class="eco-icon gdg">
            <i class="fab fa-google" aria-hidden="true"></i>
          </div>
          <div class="eco-text">
            <h4>Google Developer Group (GDG)</h4>
            <p>
              Bénévole engagé lors des ateliers techniques, meetups et
              conférences locales pour l'acculturation des étudiants aux
              standards de l'industrie logicielle.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(135deg, #ffffff 40%, #e0e7ff 75%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 20px;
  }

  .contact-primary {
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .primary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .status-indicator-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
    box-shadow: 0 0 10px -2px rgba(34, 197, 94, 0.2);
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    animation: pulse-glow 2.5s infinite ease-in-out;
  }

  .location-badge {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .primary-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-h2 {
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
  }

  .contact-p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .direct-email-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 14px 18px;
    border-radius: 8px;
    transition: var(--transition);
    margin-top: 8px;
  }

  .direct-email-card:hover {
    background: rgba(56, 189, 248, 0.06);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 0 20px -4px rgba(56, 189, 248, 0.25);
    transform: translateY(-1px);
  }

  .email-icon {
    font-size: 1.2rem;
    color: var(--accent-primary);
  }

  .email-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .email-hint {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .email-val {
    font-size: 0.92rem;
    color: #ffffff;
    font-weight: 500;
    word-break: break-all;
  }

  .email-action-icon {
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .networks-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .network-card {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .network-header {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .network-header i {
    font-size: 1.3rem;
    color: var(--text-main);
  }

  .network-header h3 {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .network-header p {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .network-card .btn {
    font-size: 0.76rem;
    padding: 6px 12px;
  }

  .network-tag {
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  .ecosystem-section {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .eco-item {
    display: flex;
    gap: 14px;
    padding: 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    transition: var(--transition);
  }

  .eco-item:hover {
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.5);
  }

  .eco-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .eco-icon.python {
    background: rgba(56, 189, 248, 0.08);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .eco-icon.gdg {
    background: rgba(239, 68, 68, 0.08);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .eco-text h4 {
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: #ffffff;
  }

  .eco-text p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .ecosystem-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 1.6rem;
    }
    .contact-primary {
      padding: 20px;
    }
  }
</style>
