---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { path: "/", label: "Overview", icon: "fas fa-grip-vertical" },
  { path: "/projects", label: "Projets", icon: "fas fa-terminal" },
  { path: "/certifications", label: "Certifs", icon: "fas fa-certificate" },
  { path: "/contact", label: "Contact", icon: "fas fa-paper-plane" },
];

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(path);
};
---

<nav class="mobile-nav" aria-label="Navigation mobile">
  <div class="mobile-nav-container">
    {navItems.map((item) => {
      const active = isActive(item.path);
      return (
        <a
          href={item.path}
          class={`mobile-nav-item ${active ? "active" : ""}`}
          aria-current={active ? "page" : undefined}
          aria-label={item.label}
        >
          <i class={item.icon} aria-hidden="true"></i>
          <span class="mobile-nav-label font-mono">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .mobile-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(12, 12, 14, 0.95);
    border-top: 1px solid var(--border-color);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 9999;
    padding: 6px 12px calc(6px + env(safe-area-inset-bottom, 0px)) 12px;
  }

  .mobile-nav-container {
    display: flex;
    justify-content: space-around;
    align-items: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .mobile-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 64px;
    min-height: 48px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--text-dim);
    text-decoration: none;
    transition: var(--transition);
  }

  .mobile-nav-item i {
    font-size: 1.05rem;
  }

  .mobile-nav-label {
    font-size: 0.68rem;
    letter-spacing: -0.01em;
  }

  .mobile-nav-item.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-item.active i {
    color: var(--accent-primary);
  }

  @media (max-width: 1024px) {
    .mobile-nav {
      display: block;
    }
  }
</style>
