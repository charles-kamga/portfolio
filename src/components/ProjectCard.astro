---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  categoryLabel: string;
  tags: string[];
  image: string;
  badge: string;
  sourceUrl?: string;
  demoUrl?: string;
  metrics?: Array<{ label: string; value: string }>;
}

const {
  slug,
  title,
  description,
  category,
  categoryLabel,
  tags,
  image,
  badge,
  sourceUrl,
  demoUrl,
  metrics,
} = Astro.props;

const webpImage = image.replace(/\.(png|jpg|jpeg)$/i, ".webp");
---

<article class="project-card bento-card" data-category={category}>
  <div class="card-media">
    <picture>
      <source srcset={webpImage} type="image/webp" />
      <img
        src={image}
        alt={`Architecture et interface de ${title}`}
        loading="lazy"
        class="project-img"
      />
    </picture>
    <div class="media-overlay">
      <span class="media-badge font-mono">
        <i class="fas fa-terminal" aria-hidden="true"></i>
        <span>{badge}</span>
      </span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="category-indicator font-mono">{categoryLabel}</span>
    </div>

    <h3 class="card-title">
      <a href={`/projects/${slug}`}>{title}</a>
    </h3>

    <p class="card-desc">{description}</p>

    {metrics && metrics.length > 0 && (
      <div class="card-metrics-grid">
        {metrics.map((m) => (
          <div class="metric-cell font-mono">
            <span class="metric-key">{m.label}</span>
            <span class="metric-val">{m.value}</span>
          </div>
        ))}
      </div>
    )}

    <div class="card-tags tech-stack">
      {tags.map((t) => (
        <span class="tech-tag">{t}</span>
      ))}
    </div>
  </div>

  <div class="card-footer">
    <a href={`/projects/${slug}`} class="btn btn-secondary btn-star">
      <i class="fas fa-book-open" aria-hidden="true"></i>
      <span>Étude d'ingénierie (STAR)</span>
    </a>

    {sourceUrl && (
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary btn-icon"
        aria-label={`Code source GitHub de ${title}`}
      >
        <i class="fab fa-github" aria-hidden="true"></i>
      </a>
    )}

    {demoUrl && (
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary btn-icon"
        aria-label={`Release ou démo de ${title}`}
      >
        <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 190px;
    background: #0d0d12;
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.3s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.04);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 50%,
      rgba(9, 9, 11, 0.9) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 12px;
  }

  .media-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(9, 9, 11, 0.85);
    color: #e4e4e7;
    border: 1px solid var(--border-color);
  }

  .media-badge i {
    color: var(--accent-primary);
    font-size: 0.7rem;
  }

  .card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-meta {
    margin-bottom: 6px;
  }

  .category-indicator {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .card-title a {
    color: #ffffff;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent-primary);
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .card-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 14px;
  }

  .metric-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-key {
    font-size: 0.65rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .metric-val {
    font-size: 0.78rem;
    font-weight: 600;
    color: #f4f4f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-tags {
    margin-top: auto;
    padding-top: 10px;
  }

  .card-footer {
    padding: 14px 20px;
    border-top: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.015);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .btn-star {
    flex: 1;
    font-size: 0.82rem;
  }

  .btn-icon {
    width: 40px;
    height: 40px;
    padding: 0;
    color: var(--text-muted);
  }

  .btn-icon:hover {
    color: #ffffff;
  }
</style>
