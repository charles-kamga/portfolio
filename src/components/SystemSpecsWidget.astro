---
---

<div class="system-specs bento-card">
  <div class="specs-header">
    <div class="header-left">
      <span class="terminal-dot red"></span>
      <span class="terminal-dot yellow"></span>
      <span class="terminal-dot green"></span>
      <span class="terminal-title">env://charles-workstation</span>
    </div>
    <span class="live-pill">
      <span class="pulse-dot"></span> Arch Linux x86_64
    </span>
  </div>

  <div class="specs-body">
    <div class="spec-row">
      <span class="spec-key">KERNEL</span>
      <span class="spec-val font-mono val-emerald">
        Linux 6.x (zen/hardened)
      </span>
    </div>
    <div class="spec-row">
      <span class="spec-key">WM / COMP</span>
      <span class="spec-val font-mono val-purple">Hyprland (Wayland)</span>
    </div>
    <div class="spec-row">
      <span class="spec-key">CORE RUNTIMES</span>
      <span class="spec-val font-mono val-amber">
        Python 3.12+ · Node 22 · C (GCC)
      </span>
    </div>
    <div class="spec-row">
      <span class="spec-key">PROTOCOLS</span>
      <span class="spec-val font-mono val-cyan">
        POSIX Sockets · WebRTC · PipeWire
      </span>
    </div>
    <div class="spec-row">
      <span class="spec-key">SECURITY TOOLING</span>
      <span class="spec-val font-mono val-rose">
        Wireshark · OpenSSL · Iptables · Docker
      </span>
    </div>
  </div>

  <div class="specs-footer font-mono">
    <span class="prompt-symbol">$</span>
    <span class="cmd-text">uptime --pretty</span>
    <span class="terminal-cursor"></span>
    <span class="cmd-output">up daily dev · 0 alerts</span>
  </div>
</div>

<style>
  .system-specs {
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
  }

  .specs-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 14px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .terminal-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    transition: var(--transition);
  }

  .terminal-dot.red {
    background: #ef4444;
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.4);
  }
  .terminal-dot.yellow {
    background: #f59e0b;
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.4);
  }
  .terminal-dot.green {
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-left: 6px;
    letter-spacing: -0.01em;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #e4e4e7;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-success);
    animation: pulse-glow 2s infinite ease-in-out;
  }

  .specs-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 14px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 0.82rem;
  }

  .spec-key {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .spec-val {
    text-align: right;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .val-emerald {
    color: #34d399;
  }
  .val-purple {
    color: #c084fc;
  }
  .val-amber {
    color: #fcd34d;
  }
  .val-cyan {
    color: #38bdf8;
  }
  .val-rose {
    color: #fb7185;
  }

  .specs-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-dim);
  }

  .prompt-symbol {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .cmd-text {
    color: #e4e4e7;
  }

  .cmd-output {
    margin-left: auto;
    color: #71717a;
  }
</style>
