---
---

<header class="hero-bento bento-card">
  <div class="hero-main-row">
    <div class="avatar-block">
      <picture>
        <source srcset="/assets/images/photo.webp" type="image/webp" />
        <img
          src="/assets/images/photo.png"
          alt="Charles Cyrille Kamga Mukam"
          width="130"
          height="130"
          class="hero-photo"
          loading="eager"
        />
      </picture>
    </div>

    <div class="hero-body">
      <div class="status-row">
        <span class="availability-badge">
          <span class="status-dot"></span>
          <span>Disponible · Backend &amp; Ingénierie Systèmes</span>
        </span>
        <span class="location-label font-mono">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Yaoundé, Cameroun ·
          Remote OK
        </span>
      </div>

      <div class="identity-block">
        <h1 class="engineer-name">Charles Cyrille Kamga Mukam</h1>
        <p class="engineer-title font-mono">
          Backend Software &amp; Systems Engineer
        </p>
      </div>

      <p class="engineer-summary">
        Spécialisé dans le développement de services asynchrones Python haute
        disponibilité, d'outils système sous Linux et de protocoles réseau
        locaux sécurisés. Approche guidée par la simplicité architecturale, la
        résilience et la sécurité par conception.
      </p>

      <div class="stack-row tech-stack">
        <span class="tech-tag accent">Python (FastAPI / Flask)</span>
        <span class="tech-tag accent">Arch Linux (Hyprland / POSIX)</span>
        <span class="tech-tag">C (Sockets / O(1) Data Structures)</span>
        <span class="tech-tag">Node.js (WebRTC / Socket.IO)</span>
        <span class="tech-tag">AppSec (OWASP / Def. in Depth)</span>
        <span class="tech-tag">Docker</span>
      </div>

      <div class="actions-row">
        <a href="/projects" class="btn btn-primary">
          <i class="fas fa-terminal" aria-hidden="true"></i>
          <span>Explorer les réalisations</span>
        </a>
        <a href="/certifications" class="btn btn-secondary">
          <i class="fas fa-certificate" aria-hidden="true"></i>
          <span>Accréditations IBM</span>
        </a>
        <a href="/contact" class="btn btn-secondary">
          <i class="fas fa-envelope" aria-hidden="true"></i>
          <span>Contact direct</span>
        </a>
      </div>
    </div>
  </div>

  <div class="community-strip">
    <div class="comm-entry">
      <i class="fab fa-python" aria-hidden="true"></i>
      <span>
        Contributeur <strong>Python Cameroun</strong>
      </span>
    </div>
    <span class="divider">/</span>
    <div class="comm-entry">
      <i class="fab fa-google" aria-hidden="true"></i>
      <span>
        Bénévole <strong>GDG (Google Developer Group)</strong>
      </span>
    </div>
    <span class="divider">/</span>
    <div class="comm-entry">
      <i class="fab fa-youtube" aria-hidden="true"></i>
      <span>
        Chaîne éducative <strong>Charltech</strong>
      </span>
    </div>
  </div>
</header>

<style>
  .hero-bento {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
  }

  .hero-main-row {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .avatar-block {
    flex-shrink: 0;
  }

  .hero-photo {
    width: 130px;
    height: 130px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border-color);
    background: #18181f;
  }

  .hero-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 3px 10px;
    border-radius: 6px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(74, 222, 128, 0.7);
  }

  .location-label {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .identity-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .engineer-name {
    font-size: 1.85rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .engineer-title {
    font-size: 0.88rem;
    color: var(--accent-primary);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .engineer-summary {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 720px;
  }

  .stack-row {
    margin-top: 4px;
  }

  .actions-row {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .community-strip {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-dim);
    flex-wrap: wrap;
  }

  .comm-entry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .comm-entry strong {
    color: var(--text-muted);
  }

  .divider {
    color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 768px) {
    .hero-bento {
      padding: 20px;
    }
    .hero-main-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 18px;
    }
    .status-row {
      justify-content: center;
    }
    .engineer-name {
      font-size: 1.5rem;
    }
    .engineer-summary {
      font-size: 0.88rem;
    }
    .stack-row {
      justify-content: center;
    }
    .actions-row {
      justify-content: center;
      width: 100%;
    }
    .actions-row .btn {
      width: 100%;
    }
    .community-strip {
      justify-content: center;
      font-size: 0.76rem;
    }
    .divider {
      display: none;
    }
  }
</style>
