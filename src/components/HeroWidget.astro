---
---

<header class="hero-bento bento-card">
  <div class="hero-main-row">
    <div class="avatar-block">
      <picture>
        <source srcset="/assets/images/photo.webp" type="image/webp" />
        <img
          src="/assets/images/photo.png"
          alt="Charles Cyrille Kamga Mukam"
          width="130"
          height="130"
          class="hero-photo"
          loading="eager"
        />
      </picture>
    </div>

    <div class="hero-body">
      <div class="status-row">
        <span class="availability-badge">
          <span class="status-dot"></span>
          <span>Disponible · Backend &amp; Ingénierie Systèmes</span>
        </span>
        <span class="location-label font-mono">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Yaoundé, Cameroun ·
          Remote OK
        </span>
      </div>

      <div class="identity-block">
        <h1 class="engineer-name">Charles Cyrille Kamga Mukam</h1>
        <p class="engineer-title font-mono">
          Backend Software &amp; Systems Engineer
        </p>
      </div>

      <p class="engineer-summary">
        Spécialisé dans le développement de services asynchrones Python haute
        disponibilité, d'outils système sous Linux et de protocoles réseau
        locaux sécurisés. Approche guidée par la simplicité architecturale, la
        résilience et la sécurité par conception.
      </p>

      <div class="stack-row tech-stack">
        <span class="tech-tag accent-amber">Python (FastAPI / Flask)</span>
        <span class="tech-tag accent-emerald">
          Arch Linux (Hyprland / POSIX)
        </span>
        <span class="tech-tag accent-cyan">
          C (Sockets / O(1) Data Structures)
        </span>
        <span class="tech-tag accent-purple">Node.js (WebRTC / Socket.IO)</span>
        <span class="tech-tag accent-amber">
          AppSec (OWASP / Def. in Depth)
        </span>
        <span class="tech-tag accent-cyan">Docker</span>
      </div>

      <div class="actions-row">
        <a href="/projects" class="btn btn-primary">
          <i class="fas fa-terminal" aria-hidden="true"></i>
          <span>Explorer les réalisations</span>
        </a>
        <a href="/certifications" class="btn btn-secondary">
          <i class="fas fa-certificate" aria-hidden="true"></i>
          <span>Accréditations IBM</span>
        </a>
        <a href="/contact" class="btn btn-secondary">
          <i class="fas fa-envelope" aria-hidden="true"></i>
          <span>Contact direct</span>
        </a>
      </div>
    </div>
  </div>

  <div class="community-strip">
    <div class="comm-entry">
      <i class="fab fa-python" aria-hidden="true"></i>
      <span>
        Contributeur <strong>Python Cameroun</strong>
      </span>
    </div>
    <span class="divider">/</span>
    <div class="comm-entry">
      <i class="fab fa-google" aria-hidden="true"></i>
      <span>
        Bénévole <strong>GDG (Google Developer Group)</strong>
      </span>
    </div>
    <span class="divider">/</span>
    <div class="comm-entry">
      <i class="fab fa-youtube" aria-hidden="true"></i>
      <span>
        Chaîne éducative <strong>Charltech</strong>
      </span>
    </div>
  </div>
</header>

<style>
  .hero-bento {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
  }

  .hero-main-row {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .avatar-block {
    flex-shrink: 0;
  }

  .hero-photo {
    width: 130px;
    height: 130px;
    border-radius: 12px;
    object-fit: cover;
    border: 2px solid rgba(56, 189, 248, 0.3);
    box-shadow:
      0 0 25px -4px rgba(56, 189, 248, 0.25),
      0 8px 20px -6px rgba(0, 0, 0, 0.5);
    background: #18181f;
    transition: var(--transition);
  }

  .hero-photo:hover {
    border-color: rgba(56, 189, 248, 0.6);
    box-shadow:
      0 0 35px -2px rgba(56, 189, 248, 0.4),
      0 12px 24px -6px rgba(0, 0, 0, 0.6);
    transform: scale(1.02);
  }

  .hero-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #4ade80;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 3px 10px;
    border-radius: 6px;
    box-shadow: 0 0 12px -2px rgba(34, 197, 94, 0.15);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: #4ade80;
    border-radius: 50%;
    animation: pulse-glow 2.5s infinite ease-in-out;
  }

  .location-label {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .identity-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .engineer-name {
    font-size: 1.95rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #ffffff 40%, #e0e7ff 75%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .engineer-title {
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .engineer-summary {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 720px;
  }

  .stack-row {
    margin-top: 4px;
  }

  .actions-row {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .community-strip {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-dim);
    flex-wrap: wrap;
  }

  .comm-entry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition);
  }

  .comm-entry strong {
    color: var(--text-muted);
  }

  .comm-entry:hover {
    color: #ffffff;
  }

  .comm-entry:hover .fa-python {
    color: #fbbf24;
    text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
  }

  .comm-entry:hover .fa-google {
    color: #38bdf8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
  }

  .comm-entry:hover .fa-youtube {
    color: #ef4444;
    text-shadow: 0 0 10px rgba(239, 68, 68, 0.6);
  }

  .divider {
    color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 768px) {
    .hero-bento {
      padding: 20px;
    }
    .hero-main-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 18px;
    }
    .status-row {
      justify-content: center;
    }
    .engineer-name {
      font-size: 1.5rem;
    }
    .engineer-summary {
      font-size: 0.88rem;
    }
    .stack-row {
      justify-content: center;
    }
    .actions-row {
      justify-content: center;
      width: 100%;
    }
    .actions-row .btn {
      width: 100%;
    }
    .community-strip {
      justify-content: center;
      font-size: 0.76rem;
    }
    .divider {
      display: none;
    }
  }
</style>
