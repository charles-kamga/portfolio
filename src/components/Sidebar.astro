---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  {
    path: "/",
    title: "Dashboard",
    desc: "Vue d'ensemble",
    icon: "fas fa-grip-vertical",
  },
  {
    path: "/projects",
    title: "Réalisations",
    desc: "Études de cas & code",
    icon: "fas fa-terminal",
  },
  {
    path: "/certifications",
    title: "Accréditations",
    desc: "Cursus IBM & Réseaux",
    icon: "fas fa-certificate",
  },
  {
    path: "/contact",
    title: "Contact & Réseau",
    desc: "Échanges professionnels",
    icon: "fas fa-paper-plane",
  },
];

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(path);
};
---

<aside class="sidebar">
  <div class="sidebar-header">
    <a href="/" class="sidebar-logo">
      <span class="logo-mark font-mono">CK</span>
      <span class="logo-dot">.</span>
    </a>
    <span class="sidebar-badge font-mono">dev_arch</span>
  </div>

  <nav class="sidebar-nav" aria-label="Navigation principale">
    <ul class="nav-menu">
      {navItems.map((item) => {
        const active = isActive(item.path);
        return (
          <li class="nav-item">
            <a
              href={item.path}
              class={active ? "active" : ""}
              aria-current={active ? "page" : undefined}
            >
              <i class={item.icon} aria-hidden="true"></i>
              <div class="nav-text">
                <span class="nav-title">{item.title}</span>
                <span class="nav-desc">{item.desc}</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="sidebar-footer">
    <div class="status-indicator">
      <span class="pulse-dot" aria-hidden="true"></span>
      <div class="status-text font-mono">
        <span class="status-title">STATUS: ACTIVE</span>
        <span class="status-subtitle">Open to Work</span>
      </div>
    </div>

    <div class="sidebar-socials">
      <a
        href="https://github.com/charles-kamga"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de Charles Kamga"
      >
        <i class="fab fa-github" aria-hidden="true"></i>
      </a>
      <a
        href="https://www.linkedin.com/in/charles-kamga-mukam/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Charles Kamga"
      >
        <i class="fab fa-linkedin" aria-hidden="true"></i>
      </a>
      <a
        href="mailto:charleskamgapr@gmail.com"
        aria-label="Envoyer un email à Charles Kamga"
      >
        <i class="fas fa-envelope" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border-color);
    position: fixed;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 28px 16px;
    z-index: 1000;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    padding: 0 8px;
  }

  .sidebar-logo {
    display: inline-flex;
    align-items: baseline;
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.04em;
  }

  .logo-dot {
    color: var(--accent-primary);
  }

  .sidebar-badge {
    font-size: 0.68rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .sidebar-nav {
    flex: 1;
  }

  .nav-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-item a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    color: var(--text-muted);
    border-radius: 8px;
    transition: var(--transition);
    border: 1px solid transparent;
  }

  .nav-item a i {
    font-size: 0.95rem;
    width: 18px;
    text-align: center;
    color: var(--text-dim);
    transition: var(--transition);
  }

  .nav-text {
    display: flex;
    flex-direction: column;
  }

  .nav-title {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .nav-desc {
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  .nav-item a:hover {
    background: rgba(255, 255, 255, 0.04);
    color: #ffffff;
  }

  .nav-item a:hover i {
    color: var(--text-main);
  }

  .nav-item a.active {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-color);
    color: #ffffff;
  }

  .nav-item a.active i {
    color: var(--accent-primary);
  }

  .sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.2);
    padding: 8px 12px;
    border-radius: 6px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-success);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-text {
    display: flex;
    flex-direction: column;
    font-size: 0.68rem;
  }

  .status-title {
    font-weight: 600;
    color: #4ade80;
    letter-spacing: 0.05em;
  }

  .status-subtitle {
    color: var(--text-dim);
  }

  .sidebar-socials {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .sidebar-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    color: var(--text-dim);
    transition: var(--transition);
  }

  .sidebar-socials a:hover {
    color: #ffffff;
    border-color: var(--border-color);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }
  }
</style>
