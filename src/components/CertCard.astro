---
interface Props {
  title: string;
  issuer: string;
  date: string;
  category: string;
  skills: string[];
  image: string;
  url: string;
  practicalNote: string;
}

const { title, issuer, date, category, skills, image, url, practicalNote } =
  Astro.props;

const webpImage = image.replace(/\.(png|jpg)$/i, ".webp");
---

<article class="cert-card glass-card" data-category={category}>
  <div class="cert-main">
    <div class="cert-badge-wrapper">
      <picture>
        <source srcset={webpImage} type="image/webp" />
        <img
          src={image}
          alt={`Badge ${title}`}
          class="cert-badge"
          loading="lazy"
        />
      </picture>
    </div>

    <div class="cert-info">
      <div class="cert-meta">
        <span class="cert-issuer">
          <i class="fas fa-university" aria-hidden="true"></i> {issuer}
        </span>
        <span class="cert-date">
          <i class="far fa-calendar-alt" aria-hidden="true"></i> {date}
        </span>
      </div>

      <h3 class="cert-title">{title}</h3>

      <div class="cert-skills tech-stack">
        {skills.map((s) => (
          <span class="tech-tag">{s}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="cert-practical">
    <div class="practical-label">
      <i class="fas fa-laptop-code" aria-hidden="true"></i>
      <span>Mise en pratique réelle :</span>
    </div>
    <p class="practical-text">{practicalNote}</p>
  </div>

  <div class="cert-footer">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-secondary btn-verify"
    >
      <i class="fas fa-external-link-alt" aria-hidden="true"></i>
      <span>Vérifier sur Coursera</span>
    </a>
  </div>
</article>

<style>
  .cert-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: 1px solid var(--border-color);
  }

  .cert-main {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .cert-badge-wrapper {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    overflow: hidden;
  }

  .cert-badge {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cert-meta {
    display: flex;
    gap: 14px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .cert-issuer {
    color: var(--accent-primary);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .cert-date {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .cert-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: #ffffff;
  }

  .cert-skills {
    margin-top: 4px;
  }

  .cert-practical {
    background: rgba(0, 209, 255, 0.04);
    border-left: 3px solid var(--accent-primary);
    border-radius: 0 10px 10px 0;
    padding: 12px 14px;
  }

  .practical-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-primary);
    margin-bottom: 4px;
  }

  .practical-text {
    font-size: 0.85rem;
    color: #c4c4d6;
    line-height: 1.5;
  }

  .cert-footer {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
  }

  .btn-verify {
    font-size: 0.82rem;
    padding: 8px 16px;
  }

  @media (max-width: 600px) {
    .cert-main {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .cert-meta {
      justify-content: center;
    }
    .cert-skills {
      justify-content: center;
    }
    .cert-footer {
      justify-content: stretch;
    }
    .btn-verify {
      width: 100%;
    }
  }
</style>
