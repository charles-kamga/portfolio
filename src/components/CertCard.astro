---
interface Props {
  title: string;
  issuer: string;
  date: string;
  category: string;
  skills: string[];
  image: string;
  url: string;
  practicalNote: string;
}

const { title, issuer, date, category, skills, image, url, practicalNote } =
  Astro.props;

const webpImage = image.replace(/\.(png|jpg)$/i, ".webp");
---

<article class="cert-card bento-card" data-category={category}>
  <div class="cert-header">
    <div class="cert-badge-frame">
      <picture>
        <source srcset={webpImage} type="image/webp" />
        <img
          src={image}
          alt={`Badge officiel ${title}`}
          class="cert-badge"
          loading="lazy"
        />
      </picture>
    </div>

    <div class="cert-title-block">
      <div class="cert-meta font-mono">
        <span class="cert-issuer">{issuer}</span>
        <span class="meta-sep">/</span>
        <span class="cert-date">{date}</span>
      </div>
      <h3 class="cert-title">{title}</h3>
    </div>
  </div>

  <div class="cert-skills tech-stack">
    {skills.map((s) => (
      <span class="tech-tag">{s}</span>
    ))}
  </div>

  <div class="cert-application">
    <span class="app-label font-mono">
      <i class="fas fa-terminal" aria-hidden="true"></i> Contexte d'application
      :
    </span>
    <p class="app-note">{practicalNote}</p>
  </div>

  <div class="cert-actions">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-secondary btn-verify"
    >
      <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
      <span>Vérifier l'accréditation</span>
    </a>
  </div>
</article>

<style>
  .cert-card {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
  }

  .cert-header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .cert-badge-frame {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background: #0d0d12;
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .cert-badge {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-title-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .cert-issuer {
    color: var(--accent-primary);
    font-weight: 500;
  }

  .meta-sep {
    color: rgba(255, 255, 255, 0.1);
  }

  .cert-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #ffffff;
  }

  .cert-skills {
    margin-top: 2px;
  }

  .cert-application {
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid var(--accent-primary);
    padding: 10px 12px;
    border-radius: 0 6px 6px 0;
  }

  .app-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .app-label i {
    color: var(--accent-primary);
  }

  .app-note {
    font-size: 0.82rem;
    color: #c4c4cb;
    line-height: 1.5;
  }

  .cert-actions {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    justify-content: flex-end;
  }

  .btn-verify {
    font-size: 0.78rem;
    padding: 6px 14px;
    min-height: 36px;
  }

  @media (max-width: 640px) {
    .cert-actions {
      justify-content: stretch;
    }
    .btn-verify {
      width: 100%;
    }
  }
</style>
